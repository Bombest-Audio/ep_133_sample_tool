{
  "name": "ep133sampletool",
  "productName": "EP-133 Sample Tool",
  "version": "1.2.0",
  "description": "Offline sample management for the Teenage Engineering EP-133 K.O. II and EP-1320 — desktop, mobile, and plugin.",
  "license": "MIT",
  "main": "main.js",
  "homepage": "https://github.com/Bombest-Audio/ep_133_sample_tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bombest-Audio/ep_133_sample_tool.git"
  },
  "bugs": {
    "url": "https://github.com/Bombest-Audio/ep_133_sample_tool/issues"
  },
  "scripts": {
    "start": "electron . --ozone-platform=wayland",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.ep133.sampletool",
    "linux": {
      "category": "tool",
      "executableName": "ep133sampletool",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  },
  "keywords": [
    "teenage",
    "engineering",
    "ep-133",
    "sample",
    "tool"
  ],
  "author": "Thomas Phillips <thomas@bom.best> (Bombest, Inc.)",
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  }
}
