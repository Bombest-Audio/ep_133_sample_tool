<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB Host for connecting EP-133 via USB-C / OTG -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- MIDI support (filters Play Store to capable devices) -->
    <uses-feature
        android:name="android.software.midi"
        android:required="true" />

    <!-- HTTPS GET to teenage.engineering for firmware version check + Chrome Custom Tab handoff -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EP133SampleTool"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auto-launch when the EP-133 USB device is connected. Kept on a separate alias
             (not MainActivity itself) so it can be toggled at runtime: firmware flashing
             re-enumerates the device repeatedly, and if this handler is live it relaunches
             us and steals focus from the browser mid-flash. MainActivity disables this alias
             while the firmware updater is open and re-enables it on return. -->
        <activity-alias
            android:name=".UsbAttachAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity-alias>

        <activity
            android:name=".SampleManagerActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:theme="@style/Theme.EP133SampleTool" />

        <!-- Shares project backup .tar files via content:// URIs (PROJ-04).
             exported=false + scoped file_paths.xml; READ grants only at share time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
